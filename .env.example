# Copy to .env to override the defaults in docker-compose.yml

# PostgreSQL
POSTGRES_USER=bytebox
POSTGRES_PASSWORD=bytebox

# MongoDB
MONGO_USER=bytebox
MONGO_PASSWORD=bytebox

# RabbitMQ
RABBITMQ_USER=bytebox
RABBITMQ_PASSWORD=bytebox

# GitHub login: create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:5001/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google login: create an OAuth client (Web application) at https://console.cloud.google.com/
#   APIs & Services > Credentials > Create credentials > OAuth client ID
#   Authorized redirect URI: http://localhost:5001/auth/google/callback
#   While the consent screen is in "Testing", add your Google account as a test user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session tokens (shared by identity and gateway). At least 32 characters:
#   openssl rand -base64 48
JWT_SECRET=

# Local development only: enables /auth/dev/login?login=<name> (no GitHub needed)
DEV_LOGIN_ENABLED=false
